<?xml version="1.0" encoding="utf-8"?>
<!-- App tile back face (flipping variant only, shown while there are
     missed calls): big count top-left, "missed calls" under it, app label
     bottom-left like the front. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_back"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="noHideDescendants">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="4dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_back_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="48sp"
            android:fontFamily="@font/selawkl"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_back_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:textAlignment="viewStart"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:fontFamily="@font/selawk" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_back_app_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="10dp"
        android:text="@string/widget_tile_label_on_tile"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:fontFamily="@font/selawk" />
</FrameLayout>
