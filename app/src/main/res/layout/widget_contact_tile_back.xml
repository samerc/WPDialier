<?xml version="1.0" encoding="utf-8"?>
<!-- Contact tile back face (flipping variant only), on the root's accent:
     the missed count + label top-left when there are any, and the full
     name bottom-left in a larger cut (the WP people-tile "back"). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ct_back"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="noHideDescendants">

    <LinearLayout
        android:id="@+id/ct_back_missed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="4dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ct_back_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="44sp"
            android:fontFamily="@font/selawkl"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/ct_back_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAlignment="viewStart"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:fontFamily="@font/selawk" />
    </LinearLayout>

    <TextView
        android:id="@+id/ct_back_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="10dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAlignment="viewStart"
        android:textColor="#FFFFFFFF"
        android:textSize="18sp"
        android:fontFamily="@font/selawkl" />
</FrameLayout>
