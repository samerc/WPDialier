<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- Square Metro contact tile; hidden when there is no photo -->
    <ImageView
        android:id="@+id/caller_photo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="12dp"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/caller_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/selawkl"
            android:textSize="20sp"
            android:textColor="@color/wp_notif_primary"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/caller_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/selawk"
            android:textSize="13sp"
            android:textColor="@color/wp_notif_secondary"
            android:singleLine="true" />
    </LinearLayout>

    <!-- 32dp to match the size of the app icon badge the system template
         draws at the left, centered on the same axis -->
    <ImageView
        android:id="@+id/btn_decline"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="12dp"
        android:padding="8dp"
        android:src="@drawable/ic_wp_decline"
        android:background="@drawable/bg_wp_decline"
        android:contentDescription="decline" />

    <ImageView
        android:id="@+id/btn_answer"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="12dp"
        android:padding="7dp"
        android:src="@drawable/ic_wp_answer"
        android:background="@drawable/bg_wp_answer"
        android:contentDescription="answer" />
</LinearLayout>
