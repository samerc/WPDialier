<?xml version="1.0" encoding="utf-8"?>
<!-- WP people tile (static variant): the front face only. Colors are set
     at runtime (accent, optionally see-through, + contrast rule); the
     cobalt default covers the moment between placement and the first
     update. The flipping variant is widget_contact_tile_flip.xml. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ct_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0050EF">

    <include layout="@layout/widget_contact_tile_front" />
</FrameLayout>
