<?xml version="1.0" encoding="utf-8"?>
<!-- WP people tile: the contact photo filling the tile (or the accent square
     with centered initials), name bottom-left, missed count bottom-right.
     Colors are set at runtime (accent + contrast rule); the cobalt default
     covers the moment between placement and the first update. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ct_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0050EF">

    <TextView
        android:id="@+id/ct_initials"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="20dp"
        android:maxLines="1"
        android:textColor="#FFFFFFFF"
        android:fontFamily="@font/selawkl"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="14sp"
        android:autoSizeMaxTextSize="44sp"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/ct_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <!-- Keeps the white name readable over light photos. -->
    <ImageView
        android:id="@+id/ct_scrim"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_gravity="bottom"
        android:scaleType="fitXY"
        android:src="@drawable/bg_tile_scrim"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="10dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ct_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:fontFamily="@font/selawk"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/ct_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:fontFamily="@font/selawk"
            android:visibility="gone"
            android:importantForAccessibility="no" />
    </LinearLayout>
</FrameLayout>
