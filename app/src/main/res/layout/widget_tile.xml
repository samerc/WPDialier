<?xml version="1.0" encoding="utf-8"?>
<!-- WP start-screen tile (static variant): flat accent square with the
     front face only. Background color is set at runtime from the accent
     pref (optionally see-through); Android 12+ rounds the corners itself
     (WP tiles were square, nothing we can do about that). The flipping
     variant is widget_tile_flip.xml: same ids, plus the back face. -->
<!-- Default cobalt background: the picker preview and the just-placed tile
     inflate this layout statically (no runtime setBackgroundColor), and a
     transparent tile reads as broken there. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0050EF">

    <include layout="@layout/widget_tile_front" />
</FrameLayout>
