    <string name="settings_google_disabled_title">Google फ़ोन ऐप</string>
    <string name="settings_google_disabled_body">Google का फ़ोन ऐप अक्षम है, इसलिए सिर्फ़ यही ऐप कॉल संभालता है। अगर आप कभी यह ऐप अनइंस्टॉल करें, तो पहले उसे फिर से चालू कर लें ताकि आपके फ़ोन में एक डायलर बना रहे।</string>
    <string name="settings_google_app_info_button">Google Phone ऐप की जानकारी खोलें</string>
    <string name="settings_dup_notif_title">दोहरी कॉल सूचनाएँ</string>
    <string name="settings_dup_notif_body">Google का फ़ोन ऐप डिफ़ॉल्ट डायलर न होने पर भी अपनी कॉल सूचनाएँ दिखाता है। सिर्फ़ इस ऐप की सूचनाएँ देखने के लिए उसकी सूचनाएँ बंद कर दें।</string>
    <string name="settings_dup_notif_button">Google Phone की सूचना सेटिंग खोलें</string>
    <string name="settings_dup_notif_locked_hint">कुछ फ़ोन (OnePlus, OPPO...) पर वे टॉगल लॉक होते हैं। ऐसा हो तो नीचे दिए गए ऐप जानकारी पेज को खोलकर \"अक्षम करें\" पर टैप करें — यह ऐप Google के फ़ोन ऐप की जगह पूरी तरह ले लेता है, और आप उसे वहाँ से कभी भी फिर चालू कर सकते हैं।</string>
    <string name="settings_light_theme_title">हल्की थीम</string>
