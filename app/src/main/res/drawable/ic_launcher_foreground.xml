<?xml version="1.0" encoding="utf-8"?>
<!-- Dialer 8 logo: the WP dialpad (3x4 keys) with the "8" key lit.
     Grid = 10dp keys, 2dp gaps, centered; its half-diagonal (~28.6dp)
     stays inside the 33dp adaptive-icon safe circle. The 8 is CUT OUT of
     the lit key (evenOdd rings) rather than painted in blue, so the same
     drawable works as the monochrome (themed-icon) layer. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 11 dim keys -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.28"
        android:pathData="M37,31h10v10h-10z M49,31h10v10h-10z M61,31h10v10h-10z M37,43h10v10h-10z M49,43h10v10h-10z M61,43h10v10h-10z M37,55h10v10h-10z M61,55h10v10h-10z M37,67h10v10h-10z M49,67h10v10h-10z M61,67h10v10h-10z" />
    <!-- Lit 8 key: square, then each loop of the 8 as outer + inner
         circle; evenOdd leaves the ring between them transparent. The two
         loops are exactly tangent at y=59.6 (no overlap = no artifact). -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M49,55h10v10h-10z M52.4,58a1.6,1.6 0 1,0 3.2,0a1.6,1.6 0 1,0 -3.2,0z M53.15,58a0.85,0.85 0 1,0 1.7,0a0.85,0.85 0 1,0 -1.7,0z M52,61.6a2,2 0 1,0 4,0a2,2 0 1,0 -4,0z M52.8,61.6a1.2,1.2 0 1,0 2.4,0a1.2,1.2 0 1,0 -2.4,0z" />
</vector>
